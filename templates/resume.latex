\documentclass[10pt]{article}

\usepackage[a4paper,margin=0.85in,top=0.7in]{geometry}
\usepackage[T1]{fontenc}
\usepackage{caladea}
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{etoolbox}
\usepackage{needspace}
\usepackage{hyperref}
\hypersetup{colorlinks=true, urlcolor=resumeblue, linkcolor=resumeblue}

% Colors sampled from the coach's Word template (1 - Resume Building Tool_V8.pdf)
\definecolor{resumeblue}{HTML}{1F4E79}
\definecolor{resumegray}{HTML}{808080}

% Typographic scale: each level 3pt above the one it sits under, leading always
% font + 2pt. The whole scale is shifted down by a uniform SCALE OFFSET so the
% relative hierarchy is untouched -- see RULES.md §1 "Page length" for why a
% font drop (rather than a content trim) was chosen here, and keep these four
% in sync with scripts/build_reference_docx.py and the *_LINE_PT constants in
% templates/format-select.lua, which both hardcode the same numbers.
%   offset 0.0pt (original): body  9   -> entry 12   -> section 15   -> name 18
%   offset 0.5pt (current):  body  8.5 -> entry 11.5 -> section 14.5 -> name 17.5
\newcommand{\bodysize}{\fontsize{8.5}{10.5}\selectfont}
\newcommand{\entryheadersize}{\fontsize{11.5}{13.5}\selectfont}
\newcommand{\sectionheadsize}{\fontsize{14.5}{16.5}\selectfont}
\newcommand{\namesize}{\fontsize{17.5}{19.5}\selectfont}

\setlength{\parindent}{0pt}
\pagestyle{empty}
\AtBeginDocument{\bodysize}

% Page-break discipline. An entry header must never be stranded at the foot of
% a page without at least its first bullet -- that is enforced per-entry by the
% \needspace{} that templates/format-select.lua emits ahead of each
% EntryHeader Div (it sizes the reservation from the header's own line count).
% These two penalties cover the other half: never split a paragraph so that a
% single line of it lands alone on either side of a break.
\widowpenalty=10000
\clubpenalty=10000

% Section headings: gray, bold, with a rule beneath (matches template's style)
\titleformat{\section}
  {\color{resumegray}\bfseries\sectionheadsize}
  {}{0em}{}
  [{\color{resumegray}\titlerule}]
\titlespacing{\section}{0pt}{10pt}{6pt}

% Tight bullets within an entry, matching the template's compact spacing
\setlist[itemize]{topsep=2pt, partopsep=0pt, itemsep=1pt, parsep=0pt, leftmargin=1.2em}
\setlist[enumerate]{topsep=2pt, partopsep=0pt, itemsep=1pt, parsep=0pt, leftmargin=1.4em}
\providecommand{\tightlist}{\setlength{\itemsep}{1pt}\setlength{\parskip}{0pt}}

% Breathing room BETWEEN entries: space after a bullet/numbered list ends,
% i.e. before the next job/project/education entry's header starts.
\AfterEndEnvironment{itemize}{\vspace{6pt}}
\AfterEndEnvironment{enumerate}{\vspace{6pt}}

\begin{document}
$body$
\end{document}
