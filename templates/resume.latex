\documentclass[10pt]{article}

\usepackage[a4paper,margin=0.85in,top=0.7in]{geometry}
\usepackage[T1]{fontenc}
\usepackage{caladea}
\usepackage{xcolor}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage{etoolbox}
\usepackage{hyperref}
\hypersetup{colorlinks=true, urlcolor=resumeblue, linkcolor=resumeblue}

% Colors sampled from the coach's Word template (1 - Resume Building Tool_V8.pdf)
\definecolor{resumeblue}{HTML}{1F4E79}
\definecolor{resumegray}{HTML}{808080}

% Typographic scale: each level 3pt above the one it sits under.
%   body 9pt -> entry title 12pt -> section heading 15pt -> name 18pt
\newcommand{\bodysize}{\fontsize{9}{11}\selectfont}
\newcommand{\entryheadersize}{\fontsize{12}{14}\selectfont}
\newcommand{\sectionheadsize}{\fontsize{15}{17}\selectfont}
\newcommand{\namesize}{\fontsize{18}{20}\selectfont}

\setlength{\parindent}{0pt}
\pagestyle{empty}
\AtBeginDocument{\bodysize}

% Section headings: gray, bold, with a rule beneath (matches template's style)
\titleformat{\section}
  {\color{resumegray}\bfseries\sectionheadsize}
  {}{0em}{}
  [{\color{resumegray}\titlerule}]
\titlespacing{\section}{0pt}{10pt}{6pt}

% Tight bullets within an entry, matching the template's compact spacing
\setlist[itemize]{topsep=2pt, partopsep=0pt, itemsep=1pt, parsep=0pt, leftmargin=1.2em}
\setlist[enumerate]{topsep=2pt, partopsep=0pt, itemsep=1pt, parsep=0pt, leftmargin=1.4em}
\providecommand{\tightlist}{\setlength{\itemsep}{1pt}\setlength{\parskip}{0pt}}

% Breathing room BETWEEN entries: space after a bullet/numbered list ends,
% i.e. before the next job/project/education entry's header starts.
\AfterEndEnvironment{itemize}{\vspace{6pt}}
\AfterEndEnvironment{enumerate}{\vspace{6pt}}

\begin{document}
$body$
\end{document}
