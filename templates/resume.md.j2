{# Generated Pandoc-flavored Markdown, ATS-safe: single-column layout, no
   tables, no side-by-side columns. Sizing for the name and entry-header
   lines comes from custom-style Divs -- for the PDF this is applied by
   templates/format-select.lua (a LaTeX size command); for the docx it maps
   to the matching named style in templates/reference.docx. Everything else
   is plain pandoc markdown, identical for both outputs.

   Entry headers (Experience, Projects) are standardized to 3 lines: name
   (Company / Project title, bold) / role (+ location or sponsor in
   parens) / dates -- each forced onto its own line via a markdown hard
   line-break (trailing "\" + newline) so all 3 stay inside one
   EntryHeader-styled paragraph regardless of content length. A line is
   omitted if its field is empty (e.g. no dates). Education and
   Volunteering keep a 2-line header (name / dates); Education's degree
   stays a bullet rather than a header line. #}
::: {custom-style="ResumeName"}
**{{ personal.name }}**
:::

{{ personal.phone }} | {{ personal.email }} | {{ personal.linkedin.display }} | {{ personal.location }}

{% if summary %}
{{ summary }}

{% endif %}
{% for section in sections -%}
{% if section == 'experience' and experience %}
# WORK EXPERIENCE

{% for job in experience %}
{% set role_line = ("\\\n" + job.role) if job.role else "" %}
{% set date_line = ("\\\n" + job.dates) if job.dates else "" %}
::: {custom-style="EntryHeader"}
**{{ job.company }}**{% if job.location %} | {{ job.location }}{% endif %}{{ role_line }}{{ date_line }}
:::

{% for bullet in job.bullets %}
- {{ bullet }}
{% endfor %}

{% endfor %}
{% elif section == 'projects' and projects %}
# PROJECTS

{% for proj in projects %}
{% set role_text = proj.role %}
{% if proj.sponsor %}{% set role_text = (role_text + " (" + proj.sponsor + ")") if role_text else proj.sponsor %}{% endif %}
{% set role_line = ("\\\n" + role_text) if role_text else "" %}
{% set date_line = ("\\\n" + proj.dates) if proj.dates else "" %}
::: {custom-style="EntryHeader"}
**{{ loop.index }}. {{ proj.title }}**{{ role_line }}{{ date_line }}
:::

{% for bullet in proj.bullets %}
- {{ bullet }}
{% endfor %}

{% endfor %}
{% elif section == 'skills' and skills %}
# SKILLS / COMPETENCIES

{% for domain in skills %}
**{{ domain.domain }}:** {{ domain.entries | join(', ') }}

{% endfor %}
{% elif section == 'education' and education %}
# EDUCATION

{% for edu in education %}
{% set date_line = ("\\\n" + edu.dates) if edu.dates else "" %}
::: {custom-style="EntryHeader"}
**{{ edu.institution }}**{{ date_line }}
:::

- {{ edu.degree }}
{% for h in edu.highlights %}
- {{ h }}
{% endfor %}

{% endfor %}
{% elif section == 'awards' and awards %}
# AWARDS / ACHIEVEMENTS / CERTIFICATES

{% for award in awards %}
{% if award.entries %}
{% for item in award.entries %}
- {{ item }}
{% endfor %}
{% else %}
{% set note_part = (' (' + award.note + ')') if award.note else '' %}
{% set date_part = (' — ' + award.date) if award.date else '' %}
- {{ award.name }}{{ note_part }}{{ date_part }}
{% endif %}
{% endfor %}

{% elif section == 'volunteering' and volunteering %}
# VOLUNTEERING & COMMUNITY SERVICE

{% for v in volunteering %}
{% set date_line = ("\\\n" + v.dates) if v.dates else "" %}
::: {custom-style="EntryHeader"}
**{{ v.name }}**{{ date_line }}
:::

{% for bullet in v.bullets %}
- {{ bullet }}
{% endfor %}

{% endfor %}
{% endif %}
{% endfor %}
