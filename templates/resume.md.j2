{# Generated Pandoc-flavored Markdown. Two tricks make one file drive both the
   PDF (LaTeX) and DOCX builds:
   1. Inline raw spans `` `\hfill`{=latex}`<w:tab/>`{=openxml} `` — pandoc only
      keeps the one matching the current writer, giving a right-aligned date
      on both outputs from a single line.
   2. `.latex-only` / `.docx-only` Divs, stripped per-format by
      templates/format-select.lua — used once, for the name/contact header,
      which needs genuinely different markup per format. #}
::: {.latex-only}
```{=latex}
\resumeheader{ {{- personal.name -}} }{ {{- personal.phone -}} }{ {{- personal.email -}} }{ {{- personal.linkedin.display -}} }{ {{- personal.location -}} }
```
:::

::: {.docx-only custom-style="ResumeName"}
{{ personal.name }}
:::

::: {.docx-only custom-style="ContactBlock"}
Mobile: {{ personal.phone }}\
Email: {{ personal.email }}\
LinkedIn: {{ personal.linkedin.display }}\
Location: {{ personal.location }}
:::

{% for section in sections -%}
{% if section == 'experience' and experience %}
# WORK EXPERIENCE

{% for job in experience %}
::: {custom-style="EntryHeader"}
**{{ job.role }}, {{ job.company }}**{% if job.location %} | {{ job.location }}{% endif %} `\hfill`{=latex}`<w:tab/>`{=openxml} {{ job.dates }}
:::

{% for bullet in job.bullets %}
- {{ bullet }}
{% endfor %}

{% endfor %}
{% elif section == 'projects' and projects %}
# PROJECTS

{% for proj in projects %}
::: {custom-style="EntryHeader"}
**{{ loop.index }}. {{ proj.title }}**{% if proj.role %} — {{ proj.role }}{% endif %}{% if proj.sponsor %} ({{ proj.sponsor }}){% endif %} `\hfill`{=latex}`<w:tab/>`{=openxml} {{ proj.dates or "" }}
:::

{% for bullet in proj.bullets %}
- {{ bullet }}
{% endfor %}

{% endfor %}
{% elif section == 'education' and education %}
# EDUCATION

{% for edu in education %}
::: {custom-style="EntryHeader"}
**{{ edu.institution }}** `\hfill`{=latex}`<w:tab/>`{=openxml} {{ edu.dates }}
:::

- {{ edu.degree }}
{% for h in edu.highlights %}
- {{ h }}
{% endfor %}

{% endfor %}
{% elif section == 'skills' and skills %}
# SKILLS / COMPETENCIES

{% for domain in skills %}
**{{ domain.domain }}**

{% for item in domain.entries %}
1. {{ item }}
{% endfor %}

{% endfor %}
{% elif section == 'awards' and awards %}
# AWARDS / ACHIEVEMENTS / CERTIFICATES

| Award / Certificate | Date |
|---|---:|
{% for award in awards -%}
{% if award.entries %}
{% for item in award.entries %}
| {{ item }} | |
{% endfor %}
{%- else %}
| {{ award.name }}{% if award.note %} ({{ award.note }}){% endif %} | {{ award.date or "" }} |
{% endif -%}
{% endfor %}

{% elif section == 'volunteering' and volunteering %}
# VOLUNTEERING & COMMUNITY SERVICE

{% for v in volunteering %}
::: {custom-style="EntryHeader"}
**{{ v.name }}**{{ (' `\\hfill`{=latex}`<w:tab/>`{=openxml} ' + v.dates) if v.dates else '' }}
:::

{% for bullet in v.bullets %}
- {{ bullet }}
{% endfor %}

{% endfor %}
{% endif %}
{% endfor %}
